    },
    {
     "id": "uca36d14f5c",
     "role": "cell",
     "zh": "用于烧录空片或者非空片"
    },
    {
     "id": "u4418053ea3",
     "role": "cell",
     "zh": "下载目录中，通过 ⟦1⟧isd_download⟦/1⟧ 生成"
    },
    {
     "id": "uc544507e57",
     "role": "cell",
     "zh": "用于烧录非空片，或者 OTA 升级"
    },
