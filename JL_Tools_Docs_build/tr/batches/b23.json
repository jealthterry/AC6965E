     "zh": "长度"
    },
    {
     "id": "udafdf682ba",
     "role": "cell",
     "zh": "16进制"
    },
    {
     "id": "ufc0f8ec3ad",
     "role": "cell",
     "zh": "0: 未配对 ; 1: 已配对"
