     "id": "u8cb1bed130",
     "role": "p",
     "zh": "V1.3.2增加校验蓝牙名"
    },
    {
     "id": "u4eb080b352",
     "role": "p",
     "zh": "使用该校验功能需要开启有线串口模式配置下的测试使能，需关闭升级使能。"
    },
    {
     "id": "ud7da22ebf9",
     "role": "p",
     "zh": "设置“0”关闭对应的测试选项。⟦1/⟧ 设置“1”开启对应的测试功能，具体的测试指标由其下方的配置框设置。"
    },
    {
     "id": "uf958561629",
     "role": "p",
     "zh": "该模式下设备不在线时显示校验模式以及版本号，在线的情况下显示测试的结果。"
    },
    {
     "id": "u626e53bd12",
     "role": "p",
     "zh": "V1.3.2版本修改显示校验结果上面一行固定显示下面一行为刷新显示。"
    },
