     "role": "p",
     "zh": "V1.2.5.d增加蓝牙2.4G接入码设置"
    },
    {
     "id": "u58838d05d6",
     "role": "p",
     "zh": "⟦1⟧使用时打开拨码开关6⟦/1⟧ ⟦2/⟧"
    },
    {
     "id": "uc0abc332ea",
     "role": "p",
     "zh": "该值为“0”默认通用蓝牙连接；⟦1/⟧"
    },
    {
     "id": "u335cf26896",
     "role": "p",
     "zh": "该值非“0”为设置的配对码。"
    },
